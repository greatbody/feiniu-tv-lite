<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FeiniuTvLite.Launch" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_launch_screen</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.FeiniuTvLite" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_content_1</item>
        <item name="android:colorBackground">@color/bg_content_1</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_active</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:textColor">@color/text_title</item>
    </style>

    <style name="Theme.FeiniuTvLite.Browse" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/bg_content_1</item>
        <item name="android:colorBackground">@color/bg_content_1</item>
        <item name="defaultBrandColor">@color/bg_content_1</item>
        <item name="defaultSearchColor">@color/brand</item>
    </style>

    <!-- ===== 文字样式 ===== -->
    <style name="TextStyle.Title" parent="android:TextAppearance">
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">@dimen/text_title_m</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextStyle.Desc" parent="android:TextAppearance">
        <item name="android:textColor">@color/text_desc</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextStyle.Tips" parent="android:TextAppearance">
        <item name="android:textColor">@color/text_tips</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>
</resources>
